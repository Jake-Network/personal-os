# cp docker/env.sample docker/.env  후 비밀값을 채우세요. docker/.env 는 커밋하지 않습니다.

# <------------ POSTGRES ------------>
POSTGRES_USER=personal_os
POSTGRES_PASSWORD=
POSTGRES_DB=personal_os
DB_PORT=5432                 # 호스트에서 DB 도구로 접속할 포트 (127.0.0.1 only)

# <------------ API ------------>
API_PORT=8000                # 호스트 포트. OAuth redirect: http://127.0.0.1:${API_PORT}/auth/callback
FRONTEND_URL=http://127.0.0.1:5173

# 컨테이너 시작 시 커밋된 Alembic head까지 적용. 0은 점검/legacy 편입용 컨테이너에서만 사용.
PERSONAL_OS_AUTO_MIGRATE=1
PERSONAL_OS_MIGRATION_TIMEOUT_SECONDS=60

# <------------ SECURITY ------------>
# OAuth 토큰 암호화용 Fernet 키. 비워두면 app_data 볼륨에 자동 생성됩니다.
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PERSONAL_OS_SECRET_KEY=

# <------------ ADVISOR ------------>
ADVISOR_DEFAULT_MODEL=
# 웹 검색 제공자: brave(API 키) 또는 searxng(키 없음, --profile search). 자동 전환 없음.
# 개발 compose 전용이며 운영 Docker에서는 웹 본문 수집이 비활성화됩니다.
PERSONAL_OS_WEB_SEARCH_PROVIDER=brave
PERSONAL_OS_WEB_SEARCH_API_KEY=
# searxng 시작 시 필수(비어 있으면 검색 프로세스를 실행하지 않음). 생성: python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=
SEARXNG_PORT=8888            # 호스트 포트 (127.0.0.1 only). app 컨테이너는 http://searxng:8080 사용
# 사용자가 Settings에서 API Key provider를 직접 선택할 때만 사용 (자동 전환 없음)
OPENAI_API_KEY=

# <------------ GOOGLE SHEETS OAUTH ------------>
# Google Cloud > Google Auth Platform > Clients > Web application에서 발급합니다.
# 로그인은 FRONTEND_URL의 호스트에서 시작해야 합니다. WSL 사설 IP는 Google 콜백으로 사용할 수 없습니다.
# Google Cloud의 승인된 리디렉션 URI에 아래 주소를 정확히 등록하세요.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/finance/google/callback

# Local document embeddings (docker: http://embeddings:11434; host: http://127.0.0.1:11434)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
# DenseCore: set provider=densecore, EMBEDDING_URL to its base URL (without /v1),
# model=Qwen3-Embedding-0.6B and the exact loaded /v1/models data[0].id below.
EMBEDDING_DENSECORE_MODEL_ID=

# Calendar words (오늘, 이번 주, 다음 달) resolve in this IANA time zone.
PERSONAL_OS_TIMEZONE=Asia/Seoul
