# SQLite under PERSONAL_OS_DATA_DIR when unset. PostgreSQL: postgresql+psycopg://user:pass@127.0.0.1:5432/personal_os
DATABASE_URL=
PERSONAL_OS_DATA_DIR=./data
# Fernet key for OAuth token encryption; generated into data/secret.key (0600) when empty.
PERSONAL_OS_SECRET_KEY=
# Must match the port uvicorn listens on: redirect is http://127.0.0.1:<port>/auth/callback
OAUTH_CALLBACK_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
# Extra hostnames the API answers to besides loopback/IP literals (comma-separated). This is NOT
# authentication; read docs/RELIABILITY_REVIEW.md "Remote deployment" before setting it.
PERSONAL_OS_ALLOWED_HOSTS=
# Optional; otherwise the first model listed for the signed-in account is used.
ADVISOR_DEFAULT_MODEL=
# Optional Brave Search API key. Web search/body collection runs only with per-request consent.
# Native/development only; production Docker egress intentionally rejects arbitrary web fetching.
PERSONAL_OS_WEB_SEARCH_API_KEY=
# Google ADC stays on the backend. Share the private spreadsheet with this account.
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-service-account.json
# Optional live integration test (never required by mock tests):
# PERSONAL_OS_LIVE_SHEETS=1
# GOOGLE_SHEETS_TEST_SPREADSHEET_ID=your-private-spreadsheet-id
# Google Cloud OAuth Web application: enable Sheets API and register this exact redirect.
# Client secret stays server-side. Only Sheets read-only + identity scopes are requested.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/finance/google/callback

# Local document embeddings (docker: http://embeddings:11434; host: http://127.0.0.1:11434)
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024

# Calendar words (오늘, 이번 주, 다음 달) resolve in this IANA time zone.
PERSONAL_OS_TIMEZONE=Asia/Seoul
